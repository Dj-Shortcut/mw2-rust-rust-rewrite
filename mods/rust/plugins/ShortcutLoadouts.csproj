<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <BypassFrameworkInstallChecks>true</BypassFrameworkInstallChecks>
    <FrameworkPathOverride>$(RustManagedPath)</FrameworkPathOverride>
    <_TargetFrameworkDirectories>$(RustManagedPath)</_TargetFrameworkDirectories>
    <_FullFrameworkReferenceAssemblyPaths>$(RustManagedPath)</_FullFrameworkReferenceAssemblyPaths>
    <BaseIntermediateOutputPath>../../../context/rust-plugin-build/obj/</BaseIntermediateOutputPath>
    <OutputPath>../../../context/rust-plugin-build/bin/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ShortcutLoadouts.cs" />
    <!-- Oxide.References already contains Newtonsoft.Json; avoid duplicate types. -->
    <Reference Include="$(RustManagedPath)/*.dll" Exclude="$(RustManagedPath)/Newtonsoft.Json.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireRealServerReferences" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(RustManagedPath)/Assembly-CSharp.dll') Or !Exists('$(RustManagedPath)/Oxide.Rust.dll') Or !Exists('$(RustManagedPath)/mscorlib.dll')"
           Text="Set RustManagedPath to the genuine RustDedicated managed DLL folder with its matching Oxide overlay." />
  </Target>
</Project>
