+    private static TypeRewriteContext? GetNestedTypeContext(AssemblyRewriteContext processedAssembly,
+        TypeDefinition unityType, TypeRewriteContext parentContext)
+    {
+        var registered = processedAssembly.TryGetTypeByName(unityType.FullName);
+        if (registered != null) return registered;
+
+        var newType = parentContext.NewType.NestedTypes.SingleOrDefault(it => it.Name == unityType.Name);
+        if (newType == null) return null;
+        var processedType = processedAssembly.GetContextForNewType(newType);
+        if (processedType.OriginalType != null)
+            throw new InvalidOperationException($"Nested source owner registration mismatch: {unityType.FullName}");
+        return processedType;
+    }
